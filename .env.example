# ============================================================
# PRETTY GOOD AI VOICE BOT — ENVIRONMENT VARIABLE TEMPLATE
# ============================================================
# Copy this file to `.env` and fill in your own credentials.
#   cp .env.example .env
#
# `.env` is listed in .gitignore and must NEVER be committed.
# ============================================================

# Twilio — outbound phone calls, call recording, caller ID
# https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ElevenLabs — text to speech (the patient's voice)
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_VOICE_ID_MALE=

# Deepgram — real-time speech to text (hearing the agent)
# https://console.deepgram.com
DEEPGRAM_API_KEY=

# Anthropic — Claude, the patient's brain
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ngrok — exposes the local FastAPI server to Twilio webhooks
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=

# Target number for the assessment — do not change
TARGET_PHONE_NUMBER=+18054398008

# ------------------------------------------------------------
# Optional tuning (defaults shown)
# ------------------------------------------------------------
# CLAUDE_MODEL=claude-sonnet-4-6
# ELEVENLABS_MODEL=eleven_turbo_v2_5
# DEEPGRAM_MODEL=nova-2-phonecall
# SERVER_PORT=5050
# PUBLIC_URL=            # set to skip ngrok and use your own https URL
# MAX_CALL_SECONDS=480
# GAP_BETWEEN_CALLS=60
